# Configuración del Proyecto
PROJECT_NAME="GiraGroup BI System"
ENVIRONMENT=local

# Conexión a Base de Datos (Interna en Docker)
DATABASE_URL=postgresql://giragroup_user:giragroup_secret_2026@giragroup_db:5432/giragroup_db
CATALOG_DATABASE_URL=postgresql://giragroup_user:giragroup_secret_2026@catalog_db:5432/giragroup_catalog_db

# Seguridad API (JWT)
SECRET_KEY=clave_super_secreta_jwt_2026_reemplazar_en_produccion
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=120

# Entorno Docker
DOCKER_ENV=True

# ==============================================================================
# Configuración SMTP para Envío Real de Correos OTP (2FA) y Restablecimiento
# ==============================================================================
# NOTA DEFENSIVA:
# Si SMTP_HOST se deja vacío o el servidor SMTP no responde / falla autenticación,
# el sistema realiza fallback automático sin interrumpir el login y SIEMPRE imprime
# el código OTP en la consola/terminal para pruebas ágiles por comando.
#
# Ejemplos de configuración según su proveedor:
#
# 1) Google Gmail:
#    SMTP_HOST=smtp.gmail.com
#    SMTP_PORT=587
#    SMTP_USER=tu_cuenta@gmail.com
#    SMTP_PASSWORD=xxxx xxxx xxxx xxxx   (Contraseña de Aplicación de 16 letras generada en Google Account > Seguridad > Verificación en 2 pasos > Contraseñas de aplicaciones)
#    SMTP_FROM_EMAIL=tu_cuenta@gmail.com
#    SMTP_USE_TLS=True
#    SMTP_USE_SSL=False
#
# 2) Microsoft Outlook / Office 365:
#    SMTP_HOST=smtp.office365.com
#    SMTP_PORT=587
#    SMTP_USER=tu_cuenta@outlook.com (o dominio corporativo)
#    SMTP_PASSWORD=tu_contrasena_o_app_password
#    SMTP_FROM_EMAIL=tu_cuenta@outlook.com
#    SMTP_USE_TLS=True
#    SMTP_USE_SSL=False
#
# 3) Servidor Corporativo con SSL Directo (Puerto 465):
#    SMTP_HOST=mail.tuempresa.bo
#    SMTP_PORT=465
#    SMTP_USER=notificaciones@tuempresa.bo
#    SMTP_PASSWORD=tu_password_segura
#    SMTP_FROM_EMAIL=notificaciones@tuempresa.bo
#    SMTP_USE_TLS=False
#    SMTP_USE_SSL=True
# ==============================================================================
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME="GiraGroup BI System"
SMTP_USE_TLS=True
SMTP_USE_SSL=False
SMTP_TIMEOUT=5.0