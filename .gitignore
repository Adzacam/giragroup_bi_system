# ---------------------------------------------------
# SEGURIDAD Y SECRETOS
# ---------------------------------------------------
.env
*.pem
*.key

# ---------------------------------------------------
# ENTORNOS VIRTUALES Y DEPENDENCIAS
# ---------------------------------------------------
.venv/
venv/
env/
backend/.venv/
frontend/.venv/
node_modules/
frontend/node_modules/
.pnpm-store/
frontend/.pnpm-store/
**/.pnpm-store/

# ---------------------------------------------------
# COMPILADOS Y BUILD ARTIFACTS
# ---------------------------------------------------
dist/
frontend/dist/
build/
.vite/
frontend/.vite/

# ---------------------------------------------------
# CACHÉ Y COMPILADOS DE PYTHON
# ---------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.coverage
htmlcov/
backend/tests/

# ---------------------------------------------------
# CARPETAS DEL PROYECTO (Datos Dinámicos)
# ---------------------------------------------------
# No subir documentos de GiraGroup reales (carpeta data)
uploads/data/*
!uploads/.gitkeep
!uploads/test/
!uploads/test/*

# No subir logs pesados de la IA o el sistema
logs/*.log
*.log
!logs/.gitkeep

# ---------------------------------------------------
# SISTEMA OPERATIVO Y HERRAMIENTAS
# ---------------------------------------------------
.DS_Store
Thumbs.db
.vscode/
.idea/
.docker/
.gemini/
*borrador*/
frontend/borrador web/

# ---------------------------------------------------
# ARCHIVOS GENERADOS Y PESADOS DEL PIPELINE
# ---------------------------------------------------
output/*.jsonl
output/*.csv
pipeline/semantic/beto_local/
*.pbix